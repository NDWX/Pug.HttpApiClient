{
  "realm": "acme",
  "enabled": true,
  "accessTokenLifespan": 300,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "api-client",
      "enabled": true,
      "publicClient": false,
      "secret": "api-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "short-lived-client",
      "enabled": true,
      "publicClient": false,
      "secret": "short-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "1"
      }
    },
    {
      "clientId": "password-client",
      "enabled": true,
      "publicClient": false,
      "secret": "password-secret",
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "rotating-client",
      "enabled": true,
      "publicClient": false,
      "secret": "rotating-secret",
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "1"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@acme.example",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "alice-password",
          "temporary": false
        }
      ]
    }
  ],
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0
}